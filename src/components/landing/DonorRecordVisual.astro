---
import GreenShootMark from "../branding/GreenShootMark.astro";
import { Gift, Mail, Users } from "@lucide/astro";

const fields = [
  ["Lifetime giving", "£4,850"],
  ["Regular gift", "£25 monthly"],
  ["Household", "Okonkwo household"],
  ["Preference", "Email"],
];

const activity = [
  {
    icon: Gift,
    title: "£25 regular gift received",
    detail: "Community programme · Direct debit",
    accent: true,
  },
  {
    icon: Mail,
    title: "Appeal response recorded",
    detail: "Spring appeal · Email reply",
  },
  {
    icon: Users,
    title: "Household relationship reviewed",
    detail: "Okonkwo household · Updated by Maya",
  },
];
---
<figure
      class="relative h-full w-full overflow-hidden bg-[hsl(var(--brand-wash))] p-4 sm:p-5"
      aria-labelledby="donor-record-visual-caption"
    >
      <figcaption
        id="donor-record-visual-caption"
        class="relative z-10 flex items-center gap-1.5 text-[10px] font-medium uppercase tracking-wider text-[hsl(var(--brand-strong))]"
      >
        <GreenShootMark class="h-4 w-4 md:h-4 md:w-4" />
        Illustrative product view
      </figcaption>

      <div
        aria-hidden="true"
        class="absolute inset-x-4 -bottom-3 top-11 overflow-hidden rounded-t-lg border border-border bg-card sm:inset-x-7 sm:top-12"
      >
        <div class="flex h-8 items-center justify-between border-b border-border px-3 text-[10px] sm:h-9 sm:px-4 sm:text-xs">
          <div class="flex min-w-0 items-center gap-2">
            <span class="grid h-4 w-4 shrink-0 place-items-center rounded bg-[hsl(var(--brand-soft))] text-[8px] font-semibold text-[hsl(var(--brand-strong))]">
              F
            </span>
            <span class="truncate text-muted-foreground">Supporters</span>
            <span class="text-border">/</span>
            <span class="truncate font-medium text-foreground">
              Aiyana Okonkwo
            </span>
          </div>
          <span class="ml-3 hidden shrink-0 rounded bg-[hsl(var(--brand-soft))] px-2 py-1 text-[10px] font-medium text-[hsl(var(--brand-strong))] sm:inline">
            Active donor
          </span>
        </div>

        <div class="hidden h-[calc(100%-2.25rem)] grid-cols-[0.9fr_1.1fr] sm:grid">
          <div class="border-r border-border p-4">
            <div class="flex items-center gap-3">
              <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-[hsl(var(--brand-soft))] text-xs font-semibold text-[hsl(var(--brand-strong))]">
                AO
              </span>
              <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-foreground">
                  Aiyana Okonkwo
                </p>
                <p class="mt-0.5 text-[11px] text-muted-foreground">
                  Regular giver · Since 2021
                </p>
              </div>
            </div>

            <dl class="mt-4 space-y-1.5">
              {fields.map(([label, value]) => (
                <div
                  class="grid min-h-6 grid-cols-[88px_1fr] items-center gap-2 text-[11px]"
                >
                  <dt class="truncate text-muted-foreground">{label}</dt>
                  <dd class="truncate font-medium text-foreground">{value}</dd>
                </div>
              ))}
            </dl>
          </div>

          <div class="min-w-0">
            <div class="flex h-9 items-center gap-5 border-b border-border px-4 text-[11px]">
              <span class="relative flex h-full items-center font-medium text-foreground after:absolute after:inset-x-0 after:bottom-0 after:h-px after:bg-foreground">
                Activity
              </span>
              <span class="text-muted-foreground">Notes</span>
              <span class="text-muted-foreground">Tasks</span>
            </div>

            <div class="px-4 py-3">
              <div class="mb-2 flex items-center gap-2 text-[10px] font-medium text-muted-foreground">
                <span>Recent activity</span>
                <span class="h-px flex-1 bg-border" />
              </div>
              <div class="space-y-1">
                {activity.map((item) => {
                  const Icon = item.icon;
                  return (
                    <div
                      class="grid grid-cols-[24px_1fr] gap-2 py-1.5"
                    >
                      <span
                        class={`grid h-6 w-6 place-items-center rounded-md border ${
                          item.accent
                            ? "border-[hsl(var(--brand-line))] bg-[hsl(var(--brand-soft))] text-[hsl(var(--brand-strong))]"
                            : "border-border bg-secondary text-muted-foreground"
                        }`}
                      >
                        <Icon class="h-3 w-3" stroke-width={1.75} />
                      </span>
                      <div class="min-w-0">
                        <p class="truncate text-[11px] font-medium text-foreground">
                          {item.title}
                        </p>
                        <p class="mt-0.5 truncate text-[10px] text-muted-foreground">
                          {item.detail}
                        </p>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        </div>

        <div class="p-3 sm:hidden">
          <div class="flex items-center gap-2.5">
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-[hsl(var(--brand-soft))] text-[10px] font-semibold text-[hsl(var(--brand-strong))]">
              AO
            </span>
            <div class="min-w-0">
              <p class="truncate text-xs font-semibold">Aiyana Okonkwo</p>
              <p class="text-[9px] text-muted-foreground">
                Regular giver · £4,850 lifetime
              </p>
            </div>
          </div>
          <div class="mt-3 border-t border-border pt-2">
            {activity.slice(0, 2).map((item) => {
              const Icon = item.icon;
              return (
                <div
                  class="flex items-center gap-2 py-1.5 text-[9px]"
                >
                  <Icon
                    class="h-3 w-3 shrink-0 text-[hsl(var(--brand-strong))]"
                    stroke-width={1.75}
                  />
                  <span class="truncate text-foreground">{item.title}</span>
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </figure>
