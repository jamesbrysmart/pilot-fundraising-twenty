---
import GreenShootMark from "../branding/GreenShootMark.astro";

const lanes = [
  {
    label: "Research",
    count: 2,
    total: "£38k",
    cards: [{ title: "Youth wellbeing fund", funder: "North Star Trust", amount: "£22k" }],
  },
  {
    label: "Drafting",
    count: 3,
    total: "£86k",
    cards: [
      { title: "Community health programme", funder: "Carter Foundation", amount: "£40k" },
      { title: "STEM bursary expansion", funder: "Lumen Trust", amount: "£24k" },
    ],
  },
  {
    label: "Submitted",
    count: 4,
    total: "£154k",
    cards: [
      { title: "Children’s respite grant", funder: "Harper Family Office", amount: "£60k" },
    ],
  },
  {
    label: "Decision",
    count: 2,
    total: "£92k",
    cards: [
      { title: "Winter shelter programme", funder: "Nora Khan", amount: "£52k" },
    ],
  },
  {
    label: "Awarded",
    count: 2,
    total: "£118k",
    awarded: true,
    cards: [
      { title: "Crisis support response", funder: "Haven Partners", amount: "£68k" },
    ],
  },
];
import OpportunityCard from "./OpportunityCard.astro";
const mobileLanes = [lanes[0], lanes[2], lanes[4]];
---
<figure
      class="relative h-full w-full overflow-hidden bg-[hsl(var(--brand-wash))] p-4 sm:p-5"
      aria-labelledby="fundraising-pipeline-visual-caption"
    >
      <figcaption
        id="fundraising-pipeline-visual-caption"
        class="relative z-10 flex items-center gap-1.5 text-[10px] font-medium uppercase tracking-wider text-[hsl(var(--brand-strong))]"
      >
        <GreenShootMark class="h-4 w-4 md:h-4 md:w-4" />
        Illustrative product view
      </figcaption>

      <div
        aria-hidden="true"
        class="absolute inset-x-4 -bottom-3 top-11 overflow-hidden rounded-t-lg border border-border bg-card sm:inset-x-7 sm:top-12"
      >
        <div class="flex h-8 items-center justify-between border-b border-border px-3 text-[10px] sm:h-9 sm:px-4 sm:text-xs">
          <div class="flex min-w-0 items-center gap-2">
            <span class="grid h-4 w-4 shrink-0 place-items-center rounded bg-[hsl(var(--brand-soft))] text-[8px] font-semibold text-[hsl(var(--brand-strong))]">
              F
            </span>
            <span class="truncate text-muted-foreground">Fundraising pipelines</span>
            <span class="text-border">/</span>
            <span class="truncate font-medium text-foreground">Grant applications</span>
          </div>
          <span class="ml-3 hidden shrink-0 text-[10px] text-muted-foreground sm:inline">
            13 active · £488k
          </span>
        </div>

        <div class="hidden h-[calc(100%-2.25rem)] grid-cols-5 px-2 sm:grid">
          {lanes.map((lane, laneIndex) => (
            <div
              class={`min-w-0 py-2 ${
                laneIndex < lanes.length - 1 ? "border-r border-border" : ""
              }`}
            >
              <div class="px-2">
                <div class="flex items-center justify-between gap-1">
                  <span
                    class={`truncate rounded px-1.5 py-1 text-[9px] font-medium ${
                      lane.awarded
                        ? "bg-[hsl(var(--brand-soft))] text-[hsl(var(--brand-strong))]"
                        : "bg-secondary text-foreground"
                    }`}
                  >
                    {lane.label}
                  </span>
                  <span class="text-[9px] text-muted-foreground">{lane.count}</span>
                </div>
                <p class="mt-1.5 text-[9px] font-medium text-muted-foreground">
                  {lane.total}
                </p>
              </div>
              <div class="mt-2 space-y-1.5 px-2">
                {lane.cards.map((card) => (
                  <OpportunityCard card={card} />
                ))}
              </div>
            </div>
          ))}
        </div>

        <div class="grid h-[calc(100%-2rem)] grid-cols-3 px-1.5 sm:hidden">
          {mobileLanes.map((lane, laneIndex) => (
            <div
              class={`min-w-0 py-2 ${
                laneIndex < mobileLanes.length - 1 ? "border-r border-border" : ""
              }`}
            >
              <div class="px-1.5">
                <span
                  class={`block truncate rounded px-1.5 py-1 text-[8px] font-medium ${
                    lane.awarded
                      ? "bg-[hsl(var(--brand-soft))] text-[hsl(var(--brand-strong))]"
                      : "bg-secondary text-foreground"
                  }`}
                >
                  {lane.label} · {lane.count}
                </span>
                <p class="mt-1.5 text-[8px] text-muted-foreground">{lane.total}</p>
              </div>
              <div class="mt-2 px-1.5">
                <OpportunityCard card={lane.cards[0]} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </figure>
