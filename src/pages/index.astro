---
import { renderToStaticMarkup } from "react-dom/server";
import SiteLayout from "../layouts/SiteLayout.astro";
import StaticReact from "../components/StaticReact.astro";
import GreenShootMark from "../components/branding/GreenShootMark";
import BrandCornerFade from "../components/branding/BrandCornerFade";
import HeroPreview from "../components/landing/HeroPreview";
import SignalStrip from "../components/landing/SignalStrip";
import NarrativeSection from "../components/landing/NarrativeSection";
import { scenarios } from "../data/workflows";
import DonorRecordVisual from "../components/landing/DonorRecordVisual";
import DonationProcessingVisual from "../components/landing/DonationProcessingVisual";
import RecurringGivingVisual from "../components/landing/RecurringGivingVisual";
import FundraisingPipelineVisual from "../components/landing/FundraisingPipelineVisual";
import FundraisingDashboardVisual from "../components/landing/FundraisingDashboardVisual";
import PilotProcess from "../components/landing/PilotProcess";
import OutcomesSection from "../components/landing/OutcomesSection";
import { faqs } from "../data/faqs";
import { sections } from "../data/details";
import Footer from "../components/Footer";
import { buttonVariants } from "../components/ui/button";
import { cn } from "../lib/utils";

const visuals = [
  DonorRecordVisual,
  DonationProcessingVisual,
  RecurringGivingVisual,
  FundraisingPipelineVisual,
  FundraisingDashboardVisual,
];
const primaryButton = cn(
  buttonVariants(),
  "bg-[hsl(var(--brand-strong-foreground))] text-[hsl(var(--brand-strong))] hover:bg-[hsl(var(--brand-strong-foreground)/0.9)] focus-visible:ring-[hsl(var(--brand-strong-foreground))] focus-visible:ring-offset-[hsl(var(--brand-strong))]",
);
---

<SiteLayout>
  <div class="flex min-h-screen flex-col bg-background">
    <header class="border-b border-border">
      <div class="container flex h-14 items-center justify-between">
        <div class="flex items-center gap-6">
          <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold tracking-tight text-foreground">
            <StaticReact component={GreenShootMark} className="h-6 w-6 md:h-7 md:w-7" />
            Fundraising for Twenty
          </a>
          <nav class="hidden items-center gap-3 text-xs text-muted-foreground md:flex">
            <button type="button" data-panel="details" class="underline underline-offset-4 transition-colors hover:text-foreground">
              Details
            </button>
          </nav>
        </div>
        <button type="button" data-panel="enquiry" class={cn(buttonVariants({ size: "sm" }), "bg-[hsl(var(--brand-strong))] text-[hsl(var(--brand-strong-foreground))] hover:bg-[hsl(var(--brand-strong)/0.9)] focus-visible:ring-[hsl(var(--brand-strong))]")}>
          Enquire
        </button>
      </div>
    </header>

    <main class="flex-1">
      <section class="relative overflow-hidden border-b border-[hsl(var(--brand-line))] bg-[hsl(var(--brand-strong))] py-24 text-[hsl(var(--brand-strong-foreground))] md:py-32">
        <StaticReact component={BrandCornerFade} />
        <div class="container relative z-10">
          <div class="grid gap-10 lg:grid-cols-[1fr_0.95fr] lg:items-start lg:gap-14">
            <div class="max-w-2xl space-y-6">
              <div class="flex items-center gap-3">
                <span class="h-px w-8 bg-[hsl(var(--brand-strong-foreground))] opacity-55"></span>
                <p class="text-xs font-medium uppercase tracking-widest text-[hsl(var(--brand-strong-foreground)/0.72)]">Built on Twenty CRM</p>
              </div>
              <h1 class="text-4xl font-semibold tracking-tight md:text-5xl lg:text-[3.5rem] lg:leading-[1.1]">
                A new fundraising<br /> CRM for nonprofits.
              </h1>
              <p class="max-w-md text-base leading-relaxed text-[hsl(var(--brand-strong-foreground)/0.78)]">
                Give your team the modern tools they need to manage donations and build donor relationships you can trust.
              </p>
              <p class="text-sm text-[hsl(var(--brand-strong-foreground)/0.78)]">
                Available with setup and implementation support from 3Trees Digital.
              </p>
              <div class="flex items-center gap-4 pt-2">
                <button type="button" data-panel="enquiry" class={primaryButton}>Tell us about your organisation</button>
                <button type="button" data-panel="details" class="text-sm text-[hsl(var(--brand-strong-foreground)/0.78)] underline underline-offset-2 transition-colors hover:text-[hsl(var(--brand-strong-foreground))]">More details</button>
              </div>
            </div>
            <StaticReact component={HeroPreview} />
          </div>
        </div>
        <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0">
          <span class="relative left-1/2 block h-px w-screen -translate-x-1/2 bg-[hsl(var(--brand-strong-foreground)/0.2)]"></span>
          <div class="absolute left-1/2 top-0 w-screen -translate-x-1/2">
            <div class="container relative">
              <div class="absolute left-[58%] top-0 -translate-x-1/2 -translate-y-[85%] md:left-auto md:right-12 md:translate-x-0">
                <StaticReact component={GreenShootMark} />
              </div>
            </div>
          </div>
        </div>
      </section>

      <StaticReact component={SignalStrip} />
      <StaticReact component={NarrativeSection} />

      <section class="border-y border-border bg-secondary/20">
        <div class="container pt-16 pb-24 md:py-32">
          <div class="grid gap-10 xl:grid-cols-[0.78fr_1.22fr] xl:gap-12">
            <aside class="xl:sticky xl:top-24 xl:self-start">
              <h2 class="mt-3 text-xl font-semibold tracking-tight md:text-2xl">Modern fundraising workflows</h2>
              <nav class="relative mt-6 border-l border-border pl-4" aria-label="Fundraising workflows">
                <div class="space-y-1">
                  {scenarios.map((scenario, index) => (
                    <a href={`#${scenario.anchorId}`} data-workflow-link={scenario.anchorId}
                       class={"relative block rounded-md px-2 py-2 text-sm transition-colors hover:bg-background hover:text-foreground " + (index === 0 ? "text-foreground" : "text-muted-foreground")}>
                      <span aria-hidden="true" class={"absolute -left-4 top-0 bottom-0 w-px bg-[hsl(var(--shoot))] opacity-70 " + (index === 0 ? "" : "hidden")}></span>
                      {scenario.thesis}
                    </a>
                  ))}
                </div>
              </nav>
              <div class="mt-6 border-t border-border pt-6">
                <p class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">See it working</p>
                <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                  Fundraising for Twenty is available now. We can demonstrate these workflows in the product and discuss how they could support your team.
                </p>
                <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
                  <button type="button" data-panel="enquiry" class="h-auto p-0 text-sm font-normal text-muted-foreground hover:text-foreground underline-offset-4 hover:underline">Tell us about your organisation</button>
                  <button type="button" data-panel="contact" data-source="proof-section" class="text-sm text-muted-foreground underline underline-offset-4 transition-colors hover:text-foreground">Contact us</button>
                </div>
              </div>
            </aside>
            <div class="space-y-6">
              {scenarios.map((scenario, index) => (
                <article id={scenario.anchorId} class="scroll-mt-24 overflow-hidden rounded-lg border border-border bg-card">
                  <div class="border-b border-border">
                    <div class="border-b border-border bg-background px-4 py-3 md:px-5">
                      <p class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">{scenario.thesis}</p>
                    </div>
                    <div class="relative w-full overflow-hidden bg-[hsl(var(--shoot)/0.08)] aspect-[5/4] sm:aspect-[21/9]">
                      <StaticReact component={visuals[index]} />
                    </div>
                  </div>
                  <div class="space-y-3 p-5 md:p-6">
                    <div class="space-y-2">
                      <p class="text-sm font-medium leading-relaxed">{scenario.headline}</p>
                      <p class="text-sm leading-relaxed text-muted-foreground">{scenario.description}</p>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <StaticReact component={PilotProcess} />
      <StaticReact component={OutcomesSection} />

      <section class="border-t border-border bg-secondary/40">
        <div class="container py-24 md:py-32">
          <div class="grid gap-12 md:grid-cols-[1fr_2fr]">
            <div>
              <p class="mb-3 text-[11px] uppercase tracking-wider text-muted-foreground">FAQ</p>
              <h2 class="text-lg font-semibold">Common questions</h2>
            </div>
            <div class="w-full">
              {faqs.map((faq) => (
                <details name="faq" class="group border-b border-border">
                  <summary class="flex cursor-pointer list-none items-center justify-between py-4 text-left text-sm font-medium hover:no-underline [&::-webkit-details-marker]:hidden">
                    {faq.q}
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-4 h-4 w-4 shrink-0 transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6"></path></svg>
                  </summary>
                  <div class="space-y-3 pb-4 text-sm leading-relaxed text-muted-foreground">
                    {faq.a.map((paragraph) => <p>{paragraph}</p>)}
                  </div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="relative overflow-hidden border-t border-[hsl(var(--brand-line))] bg-[hsl(var(--brand-strong))] text-[hsl(var(--brand-strong-foreground))]">
        <StaticReact component={BrandCornerFade} />
        <div class="container relative z-10 py-24 md:py-32">
          <div class="max-w-md space-y-4">
            <h2 class="text-xl font-semibold tracking-tight md:text-2xl">Let&apos;s talk about the CRM your organisation needs.</h2>
            <p class="text-sm leading-relaxed text-[hsl(var(--brand-strong-foreground)/0.78)]">
              Tell us how your organisation works, what is getting in the way and what you want your CRM to support. We&apos;ll show you Fundraising for Twenty, work through how the wider CRM should fit together and explain what implementation with 3Trees involves.
            </p>
            <div class="flex flex-wrap items-center gap-4 pt-2">
              <button type="button" data-panel="enquiry" class={primaryButton}>Tell us about your organisation</button>
              <button type="button" data-panel="details" class="text-sm text-[hsl(var(--brand-strong-foreground)/0.78)] underline underline-offset-2 transition-colors hover:text-[hsl(var(--brand-strong-foreground))]">What to expect</button>
              <button type="button" data-panel="contact" data-source="closing-cta" class="text-sm text-[hsl(var(--brand-strong-foreground)/0.78)] underline underline-offset-2 transition-colors hover:text-[hsl(var(--brand-strong-foreground))]">Contact us</button>
            </div>
          </div>
        </div>
      </section>
    </main>

    <StaticReact component={Footer} />
  </div>

  <button type="button" data-panel="enquiry" data-edge-toggle aria-expanded="false" aria-label="Open enquiry panel" aria-controls="application-sheet"
    class="fixed right-0 top-1/2 z-40 -translate-y-1/2 rounded-l-md border border-r-0 border-border bg-background/95 px-2 py-3 text-[11px] uppercase tracking-wider text-muted-foreground shadow-sm backdrop-blur transition-colors hover:text-foreground">
    <span class="[writing-mode:vertical-rl] [text-orientation:mixed]">Enquire</span>
  </button>

  <dialog id="details-dialog" aria-labelledby="details-title" class="details-dialog w-full max-w-5xl overflow-y-auto border-l border-border bg-background p-0 text-foreground shadow-lg">
    <div class="space-y-2 border-b border-border px-6 py-6 text-left">
      <h2 id="details-title" class="text-xl tracking-tight">What to expect</h2>
      <p class="text-sm text-muted-foreground">How the product, implementation and next steps work.</p>
      <button type="button" data-close-details aria-label="Close" class="absolute right-4 top-4 rounded-sm opacity-70 hover:opacity-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2">
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4"><path d="M18 6 6 18M6 6l12 12"></path></svg>
      </button>
    </div>
    <div class="h-[calc(100vh-88px)] overflow-hidden px-6 pb-8 pt-6">
      <div class="grid h-full gap-8 md:grid-cols-[220px_1fr] lg:grid-cols-[260px_1fr]">
        <nav class="hidden overflow-y-auto border-r border-border pr-4 md:flex md:flex-col md:gap-1" aria-label="Details sections">
          {sections.map((section, index) => (
            <button type="button" data-details-tab={section.id}
              class={"rounded-md px-3 py-2 text-left text-sm transition-colors " + (index === 0 ? "bg-secondary text-foreground" : "text-muted-foreground hover:bg-secondary/50 hover:text-foreground")}>
              {section.label}
            </button>
          ))}
          <div class="mt-auto border-t border-border pt-4">
            <button type="button" data-panel="enquiry" class={buttonVariants() + " h-auto min-h-10 w-full whitespace-normal py-2 leading-snug"}>Tell us about your organisation</button>
            <button type="button" data-panel="contact" data-source="details-sheet" class="mt-3 w-full text-center text-sm text-muted-foreground underline underline-offset-2 transition-colors hover:text-foreground">Contact us</button>
          </div>
        </nav>
        <div class="overflow-y-auto">
          <div class="mb-5 overflow-x-auto border-b border-border md:hidden">
            <div class="flex min-w-max gap-1 pb-2">
              {sections.map((section, index) => (
                <button type="button" data-details-tab={section.id}
                  class={"whitespace-nowrap rounded-md px-3 py-2 text-xs " + (index === 0 ? "bg-secondary text-foreground" : "text-muted-foreground")}>
                  {section.label}
                </button>
              ))}
            </div>
          </div>
          {sections.map((section, index) => (
            <div data-details-content={section.id} hidden={index !== 0} class="max-w-2xl space-y-6 pb-8">
              <h2 class="text-lg font-semibold tracking-tight">{section.label}</h2>
              <Fragment set:html={renderToStaticMarkup(section.content)} />
              <div class="border-t border-border pt-6 md:hidden">
                <div class="flex flex-wrap items-center gap-3">
                  <button type="button" data-panel="enquiry" class={buttonVariants()}>Tell us about your organisation</button>
                  <button type="button" data-panel="contact" data-source="details-sheet" class="text-sm text-muted-foreground underline underline-offset-2 transition-colors hover:text-foreground">Contact us</button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </dialog>
  <div id="forms-root"></div>
  <script>
    import "../scripts/site";
  </script>
</SiteLayout>
